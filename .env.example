# ==============================================================================
# AI Paper Trading Simulator (NSE/BSE) - Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH YOUR ACTUAL CONFIGURATION:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# --- Safety & Live Execution Guardrails ---
# Live trading must remain FALSE. The system will throw an exception if set to true without verified live broker adapter.
ENABLE_REAL_TRADING=false
PAPER_TRADING_KILL_SWITCH=false

# --- Market & Capital Configuration (Indian Stock Market) ---
PRIMARY_EXCHANGE=NSE
SECONDARY_EXCHANGE=BSE
INITIAL_VIRTUAL_CAPITAL_INR=100000.00
CURRENCY=INR

# Swing Trading Universe (Comma-separated NSE symbols with .NS suffix for Yahoo Finance)
TRADING_UNIVERSE=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS,BHARTIARTL.NS,SBIN.NS,ITC.NS,LT.NS,TATAMOTORS.NS

# Market Session Timings (IST / Asia/Kolkata timezone: UTC+05:30)
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# --- Risk Management Parameters ---
# Maximum risk per trade as a fraction of virtual equity (0.01 = 1%)
MAX_RISK_PER_TRADE=0.01
# Maximum open positions concurrently
MAX_OPEN_POSITIONS=5
# Maximum portfolio allocation per single position (0.20 = 20%)
MAX_ALLOCATION_PER_POSITION=0.20
# Default Risk-Reward Ratio (Target profit / Stop loss distance)
DEFAULT_RISK_REWARD_RATIO=2.0
# Minimum Stop Loss Percentage (e.g., 0.015 = 1.5% below entry)
MIN_STOP_LOSS_PCT=0.015

# --- Indian Market Transaction Charges & Friction Assumptions ---
# Brokerage: Flat INR 20 or 0.03% (whichever is lower) typical for discount brokers (Zerodha/Groww)
BROKERAGE_PER_ORDER_INR=20.00
# Securities Transaction Tax (STT) on delivery buy & sell: 0.1% on turnover
STT_TAX_RATE=0.001
# Exchange turnover charges (NSE cash): 0.00345%
EXCHANGE_TURNOVER_RATE=0.0000345
# SEBI charges: INR 10 per crore (0.0001%)
SEBI_CHARGES_RATE=0.000001
# Stamp duty (on buy orders only): 0.015%
STAMP_DUTY_RATE=0.00015
# GST: 18% on (Brokerage + Exchange turnover charges + SEBI charges)
GST_RATE=0.18
# Simulated Slippage in Basis Points (5 bps = 0.05%)
SLIPPAGE_BPS=5.0

# --- Technical Indicator Parameters ---
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# --- Google Gemini AI Configuration ---
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=15

# --- Market Data Provider ---
# Initial prototype uses yfinance (historical and delayed daily/hourly quotes)
DATA_PROVIDER=yfinance
DATA_CACHE_TTL_MINUTES=15

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=trader_user
POSTGRES_PASSWORD=trader_secure_password_replace_in_env
POSTGRES_DB=paper_trading_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trader_user:trader_secure_password_replace_in_env@postgres:5432/paper_trading_db
SYNC_DATABASE_URL=postgresql+psycopg2://trader_user:trader_secure_password_replace_in_env@postgres:5432/paper_trading_db

# --- Service Network Ports ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
BACKEND_INTERNAL_URL=http://backend:8000
