# syntax=docker/dockerfile:1
# Production Dockerfile for Paper Trading Backend Service
# Follows security hardening principles: non-root user, minimal image, pinned dependencies.

FROM python:3.12-slim-bookworm AS builder

# Set build environment flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /install

# Install build dependencies required for compiling C extensions (psycopg2, numpy)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /install/requirements.txt
RUN pip install --prefix=/install/local --no-cache-dir -r /install/requirements.txt


# --- Final Runtime Image ---
FROM python:3.12-slim-bookworm AS runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app"

# Install runtime dependencies (libpq for postgres, curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root user and group
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/false -m appuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install/local /usr/local

# Copy application source code
COPY --chown=appuser:appgroup backend /app/backend
COPY --chown=appuser:appgroup indicators /app/indicators
COPY --chown=appuser:appgroup strategies /app/strategies
COPY --chown=appuser:appgroup trading /app/trading
COPY --chown=appuser:appgroup database /app/database

# Switch to non-root user for security
USER appuser

EXPOSE 8000

# Container liveness health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
