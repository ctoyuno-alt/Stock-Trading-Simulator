# syntax=docker/dockerfile:1
# Production Dockerfile for React + Tailwind Quantitative Workstation
# Serves optimized Vite production build with proxy to FastAPI backend

FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm install

# Copy source and build
COPY frontend/ ./
RUN npm run build

EXPOSE 3000

ENV VITE_PROXY_TARGET=http://backend:8000

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
